{
  "expo": {
    "name": "Savemymeal",
    "slug": "savemymeal",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "savemymeal",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/brand-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#f5f7f6"
    },
    "ios": {
      "icon": "./assets/ios_app_icon.png",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We need your location to show nearby vendors and delivery options.",
        "NSFaceIDUsageDescription": "Allow Face ID to quickly and securely log into your account.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.savemymeal.app",
      "associatedDomains": ["applinks:savemymeal.com"]
    },
    "android": {
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "savemymeal.com",
              "pathPrefix": "/app/"
            },
            {
              "scheme": "https",
              "host": "savemymeal.com",
              "pathPrefix": "/ref/"
            },
            {
              "scheme": "https",
              "host": "savemymeal.com",
              "pathPrefix": "/product/"
            },
            {
              "scheme": "https",
              "host": "savemymeal.com",
              "pathPrefix": "/vendor/"
            },
            {
              "scheme": "https",
              "host": "savemymeal.com",
              "pathPrefix": "/vendors/"
            },
            {
              "scheme": "https",
              "host": "savemymeal.com",
              "pathPrefix": "/order/"
            },
            {
              "scheme": "https",
              "host": "savemymeal.com",
              "pathPrefix": "/orders/"
            },
            {
              "scheme": "https",
              "host": "savemymeal.com",
              "pathPrefix": "/pack/"
            },
            {
              "scheme": "https",
              "host": "savemymeal.com",
              "pathPrefix": "/deal/"
            },
            {
              "scheme": "https",
              "host": "savemymeal.com",
              "pathPrefix": "/campaign/"
            },
            {
              "scheme": "https",
              "host": "savemymeal.com",
              "pathPrefix": "/payment/callback"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "adaptiveIcon": {
        "backgroundColor": "#1f7a5a",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ],
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "package": "com.savemymeal.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand-logo.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#f5f7f6",
          "dark": {
            "image": "./assets/brand-logo.png",
            "backgroundColor": "#f5f7f6"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Savemymeal to use your location for nearby vendors and delivery."
        }
      ],
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "# Optional Stripe Issuing provisioning SDK is compileOnly and unused by SMM.\n-dontwarn com.stripe.android.pushProvisioning.PushProvisioningActivity$g\n-dontwarn com.stripe.android.pushProvisioning.PushProvisioningActivityStarter$Args\n-dontwarn com.stripe.android.pushProvisioning.PushProvisioningActivityStarter$Error\n-dontwarn com.stripe.android.pushProvisioning.PushProvisioningActivityStarter\n-dontwarn com.stripe.android.pushProvisioning.PushProvisioningEphemeralKeyProvider\n\n# Expo SDK 54 converts native options using Kotlin reflection (RecordTypeConverter).\n# R8 full mode must retain Kotlin metadata and property annotations, not only record fields.\n-keepattributes RuntimeVisibleAnnotations,RuntimeInvisibleAnnotations,AnnotationDefault,Signature,InnerClasses,EnclosingMethod\n-keep class kotlin.Metadata { *; }\n-keep class expo.modules.kotlin.records.** { *; }\n# Keep reflectively constructed records, including options used by location and clipboard.\n-keep class * implements expo.modules.kotlin.records.Record { *; }"
          }
        }
      ],
      "./plugins/with-android-release-optimization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e2a8b8a0-f3db-4258-b627-b81bcfec579d"
      }
    },
    "owner": "nosprodev"
  }
}
